{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xorvio",
  "version": "0.1.0",
  "identifier": "com.xorvio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Xorvio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 28 },
        "backgroundColor": "#111418",
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http://127.0.0.1:* xorvio-image: xorvio-server: xorvio-folder: xorvio-still: xorvio-art: http://xorvio-image.localhost http://xorvio-server.localhost http://xorvio-folder.localhost http://xorvio-still.localhost",
        "media-src": "'self' blob: data: http://127.0.0.1:* xorvio-folder: http://xorvio-folder.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* xorvio-folder: http://xorvio-folder.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Live TV, films and series from your own sources",
    "copyright": "Xorvio contributors, GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
